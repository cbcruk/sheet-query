{
  "name": "@cbcruk/sheet-query",
  "version": "0.1.0",
  "description": "Treat Google Sheets like a data store: SQL-like reads via GViz, type-safe writes, schema validation.",
  "keywords": [
    "google-sheets",
    "gviz",
    "query",
    "spreadsheet",
    "sql",
    "standard-schema"
  ],
  "homepage": "https://github.com/cbcruk/sheet-query#readme",
  "bugs": {
    "url": "https://github.com/cbcruk/sheet-query/issues"
  },
  "license": "MIT",
  "author": "Eunsoo Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbcruk/sheet-query.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepack": "cp ../../README.md ../../LICENSE . && vp run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
